@page "/login"
@inject NavigationManager Nav
@inject HelpDeskHero.UI.Services.Api.AuthApiClient AuthApi

<h3>Logging In</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="login-card">

    <h2 class="mb-3">Welcome Back</h2>

    <p class="text-muted mb-4">
        Sign in to continue to HelpDeskHero
    </p>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Username</label>
            <InputText class="form-control"
                       @bind-Value="_model.UserName" />
        </div>

        <div class="mb-4">
            <label>Password</label>
            <InputText class="form-control"
                       type="password"
                       @bind-Value="_model.Password" />
        </div>

        <button class="btn btn-primary w-100"
                disabled="@_busy">
            Sign In
        </button>

    </EditForm>

</div>

@code {
    private HelpDeskHero.Shared.Contracts.Auth.LoginRequestDto _model = new()
    {
        DeviceName = Environment.MachineName
    };

    private bool _busy;
    private string? _error;

    private async Task HandleLoginAsync()
    {
        _busy = true;
        _error = null;

        var ok = await AuthApi.LoginAsync(_model);

        _busy = false;

        if (!ok)
        {
            _error = "Invalid username or password.";
            return;
        }

        Nav.NavigateTo("/tickets");
    }
}