@page "/dashboard"
@using HelpDeskHero.Shared.Contracts.Dashboard
@inject HelpDeskHero.UI.Services.Api.DashboardApiClient DashboardApi

<h3>Dashboard</h3>
<div class="page-card">

@if (_model is null)
{
    <p>Loading...</p>
}
else
{
    <div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <h6 class="text-muted">Total Tickets</h6>
            <h2>@_model.TotalTickets</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <h6 class="text-muted">Open</h6>
            <h2>@_model.OpenTickets</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <h6 class="text-muted">Closed</h6>
            <h2>@_model.ClosedTickets</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <h6 class="text-muted">Deleted</h6>
            <h2>@_model.DeletedTickets</h2>
        </div>
    </div>

</div>

    <h5>Recent audit</h5>
    <table class="table">
        <thead>
            <tr>
                <th>When</th>
                <th>Action</th>
                <th>Entity</th>
                <th>User</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _model.RecentAuditItems)
            {
                <tr>
                    <td>@item.CreatedAtUtc.ToString("u")</td>
                    <td>@item.Action</td>
                    <td>@item.EntityName</td>
                    <td>@item.PerformedBy</td>
                </tr>
            }
        </tbody>
    </table>
}
</div>
@code {
    private DashboardSummaryDto? _model;

    protected override async Task OnInitializedAsync()
    {
        _model = await DashboardApi.GetSummaryAsync();
    }
}