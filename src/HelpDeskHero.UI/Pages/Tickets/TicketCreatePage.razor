@page "/tickets/create"
@attribute [Authorize]
@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Api
@inject TicketApiClient TicketApi
@inject NavigationManager Navigation
@inject HelpDeskHero.UI.Services.Api.ITicketApiClient TicketApi

<PageTitle>Create Ticket</PageTitle>

<h3>Create Ticket</h3>
<div class="page-card">

<EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Title</label>
        <InputText class="form-control" @bind-Value="_model.Title" />
        <ValidationMessage For="@(() => _model.Title)" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <InputTextArea class="form-control" @bind-Value="_model.Description" />
        <ValidationMessage For="@(() => _model.Description)" />
    </div>

    <div class="mb-3">
        <label>Priority</label>
        <InputSelect class="form-select" @bind-Value="_model.Priority">
            <option>Low</option>
            <option>Medium</option>
            <option>High</option>
            <option>Critical</option>
        </InputSelect>
        <ValidationMessage For="@(() => _model.Priority)" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <button class="btn btn-primary" type="submit" disabled="@_busy">Save</button>
</EditForm>
</div>
@code {
    private bool _busy;
    private string? _error;
    private CreateTicketDto _model = new();

    private async Task HandleSubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var result = await TicketApi.CreateAsync(_model);
            if (result is null)
            {
                _error = "Failed to save the ticket.";
                return;
            }

            Navigation.NavigateTo("/tickets");
        }
        catch
        {
            _error = "An error occurred while saving the ticket.";
        }
        finally
        {
            _busy = false;
        }
    }
}