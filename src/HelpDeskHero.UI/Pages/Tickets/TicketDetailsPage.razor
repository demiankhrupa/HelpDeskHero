@page "/tickets/{Id:int}"
@attribute [Authorize]
@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Components.Tickets
@inject HelpDeskHero.UI.Services.Api.ITicketApiClient TicketApi
@inject NavigationManager Nav

<h3>Szczegoly zgloszenia</h3>

@if (_ticket is null)
{
    <p>Ladowanie...</p>
}
else
{
    <p><strong>Numer:</strong> @_ticket.Number</p>
    <p><strong>Tytul:</strong> @_ticket.Title</p>
    <p><strong>Status:</strong> @_ticket.Status</p>
    <p><strong>Priorytet:</strong> @_ticket.Priority</p>
    <p><strong>Opis:</strong> @_ticket.Description</p>

    <button class="btn btn-primary me-2"
        @onclick='() => Nav.NavigateTo($"/tickets/edit/{Id}")'>
    Edytuj
</button>

<button class="btn btn-danger"
        @onclick="DeleteAsync">
    Usuń
</button>

<hr />

<h4>Komentarze</h4>

<TicketComments TicketId="@Id" />

<hr />

<h3>Załączniki</h3>

<TicketAttachments TicketId="@Id" />
}

@code {
    [Parameter] public int Id { get; set; }

    private TicketDto? _ticket;

    protected override async Task OnParametersSetAsync()
    {
        _ticket = await TicketApi.GetByIdAsync(Id);
    }
    private async Task DeleteAsync()
{
    var response = await TicketApi.DeleteAsync(Id);

    if (response.IsSuccessStatusCode)
    {
        Nav.NavigateTo("/tickets");
    }
}
}