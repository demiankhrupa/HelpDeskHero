@page "/tickets/{Id:int}"
@attribute [Authorize]
@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Components.Tickets
@using HelpDeskHero.UI.Components
@inject HelpDeskHero.UI.Services.Api.ITicketApiClient TicketApi
@inject NavigationManager Nav

<div class="page-card">

@if (_ticket is null)
{
    <p>Loading...</p>
}
else
{
<div class="card p-4 mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h2>@_ticket.Title</h2>

            <div class="text-muted">
                @_ticket.Number
            </div>
        </div>

        <div>
            <StatusBadge Status="@_ticket.Status" />
        </div>

    </div>

    <hr />

    <div class="row">

        <div class="col-md-3 mb-3">
            <strong>Priority</strong>
            <br />
            <PriorityBadge Priority="@_ticket.Priority" />
        </div>

      <div class="col-md-3 mb-3">
    <strong>Assigned To</strong>
    <br />
    @(_ticket.AssignedToUserId ?? "Unassigned")
</div>

        <div class="col-md-3 mb-3">
            <strong>Escalation</strong>
            <br />
            @_ticket.EscalationLevel
        </div>

        <div class="col-md-3 mb-3">
            <strong>Status</strong>
            <br />
            @_ticket.Status
        </div>

    </div>

    <hr />

    <div>
        <strong>Description</strong>

        <p class="mt-2">
            @_ticket.Description
        </p>
    </div>

</div>

    <button class="btn btn-primary me-2"
        @onclick='() => Nav.NavigateTo($"/tickets/edit/{Id}")'>
    Edit
</button>

<button class="btn btn-danger"
        @onclick="DeleteAsync">
    Delete
</button>

<hr />

<h4>Comments</h4>

<TicketComments TicketId="@Id" />

<hr />

<h3>Attachments</h3>

<TicketAttachments TicketId="@Id" />
}
</div>
@code {
    [Parameter] public int Id { get; set; }

    private TicketDto? _ticket;

    protected override async Task OnParametersSetAsync()
    {
        _ticket = await TicketApi.GetByIdAsync(Id);
    }
    private async Task DeleteAsync()
{
    var response = await TicketApi.DeleteAsync(Id);

    if (response.IsSuccessStatusCode)
    {
        Nav.NavigateTo("/tickets");
    }
}
}